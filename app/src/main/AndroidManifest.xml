<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Cek pulsa/kuota otomatis via USSD & membuka menu paket operator -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Membaca daftar SIM di HP ini -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Izin SMS (RECEIVE_SMS/SEND_SMS) sengaja TIDAK dideklarasikan di build ini:
         Google Play Protect memblokir aplikasi sideload yang meminta izin SMS.
         Membaca info operator memakai "Tempel teks" / "Bagikan -> PapaMama". -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <!-- Aplikasi operator -->
        <package android:name="com.telkomsel.telkomselcm" />
        <package android:name="com.byu.id" />
        <package android:name="com.apps.MyXL" />
        <package android:name="com.pure.indosat.care" />
        <package android:name="com.hutchison3.bima" />
        <package android:name="com.smartfren.mysf" />
        <package android:name="com.smartfren" />
        <!-- E-wallet / marketplace / m-banking untuk beli pulsa & paket -->
        <package android:name="id.dana" />
        <package android:name="com.gojek.gopay" />
        <package android:name="com.gojek.app" />
        <package android:name="ovo.id" />
        <package android:name="com.shopee.id" />
        <package android:name="com.tokopedia.tkpd" />
        <package android:name="com.telkom.mwallet" />
        <package android:name="id.co.bri.brimo" />
        <package android:name="id.bmri.livin" />
        <package android:name="com.bca.mybca.omni.android" />
        <package android:name="com.bca" />
        <package android:name="src.com.bni" />
        <package android:name="id.flip" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".PapaMamaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PapaMama">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Bagikan" teks dari SMS / aplikasi operator ke PapaMama -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

    </application>
</manifest>
